#pragma once

#define WIFI_SSID "YOUR_SSID"

/*
 * 64-hex-character WPA2 PMK for this exact SSID. Passphrases are deliberately
 * rejected because the WiFi driver's NVS is disabled; derive the PMK once on
 * the host:
 *
 *   python3 -c 'import hashlib;print(hashlib.pbkdf2_hmac("sha1",b"PASSPHRASE",b"SSID",4096,32).hex())'
 */
#define WIFI_PMK_HEX "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
